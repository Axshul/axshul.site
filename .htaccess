# axshul.site (Hostinger / LiteSpeed)
ErrorDocument 404 /404.html

# keep the source-only files out of the public site
<FilesMatch "^(CLAUDE\.md|\.gitignore|\.gitattributes)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/\.(git|claude|kiro|vscode)(/|$)

# long cache for photos, short for everything else
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>
